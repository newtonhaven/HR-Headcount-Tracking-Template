# Copy this file to .env and adjust it. docker compose reads .env automatically.

APP_PORT=8080

# Names shown in the UI
APP_NAME="Norm Staffing"
ORG_NAME="Logoipsum Hospital"

# Time zone used for "today" (active employees, turnover periods), e.g. Europe/Istanbul
TZ=UTC

DB_NAME=norm_staffing
DB_USER=norm_staffing
DB_PASSWORD=change-me-to-a-long-random-password
